{
    "name": "@gebruederheitz/htmodules",
    "version": "2.0.0",
    "description": "Assemble an .htaccess file from a base file and an arbitrary number of modules.",
    "type": "module",
    "exports": {
        ".": "./src/index.mjs",
        "./package.json": "./package.json"
    },
    "browser": null,
    "bin": {
        "htmodules": "bin/cli"
    },
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gebruederheitz/htmodules.git"
    },
    "keywords": [
        "apache",
        "htaccess",
        "modules",
        "plaintextlego"
    ],
    "bugs": {
        "url": "https://github.com/gebruederheitz/htmodules/issues"
    },
    "homepage": "https://github.com/gebruederheitz/htmodules#readme",
    "license": "GPL-3.0-only",
    "author": "Andreas Maros <andreas.maros@gebruederheitz.de>",
    "scripts": {
        "lint:eslint": "eslint src/",
        "lint:prettier": "prettier -c --config ./.prettierrc src/"
    },
    "dependencies": {
        "@gebruederheitz/plaintextlego": "^1.3.2",
        "find-up": "^8.0.0",
        "lodash-es": "^4.18.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "execa": "^10.2.1",
        "globals": "^17.14.0",
        "memfs": "^4.80.0",
        "prettier": "^3.9.10",
        "release-it": "^21.1.2",
        "vitest": "^5.1.0"
    }
}
